# GAMEVERSE Configuration Template
# Copy this file to .env and fill in your values

# Telegram Bot Token (obtain from @BotFather)
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=GameverseStrategyBot

# Application Environment (development / production)
ENVIRONMENT=development
DEBUG=True

# Database Configuration
# Local development SQLite async URL:
DATABASE_URL=sqlite+aiosqlite:///./gameverse.db
# Production PostgreSQL async URL:
# DATABASE_URL=postgresql+asyncpg://gameverse_user:gameverse_pass@localhost:5432/gameverse_db

# Redis Configuration (Optional for local dev, fallback to memory)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=False

# Admin API & Security
ADMIN_API_KEY=change_this_to_a_secure_random_key_for_admin
ADMIN_TELEGRAM_IDS=123456789

# Game Engine Settings
RESOURCE_TICK_SECONDS=60
BASE_GOLD_PRODUCTION=50
BASE_WOOD_PRODUCTION=40
BASE_IRON_PRODUCTION=30
BASE_FOOD_PRODUCTION=60
BASE_STORAGE_CAPACITY=5000
